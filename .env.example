# ===========================================
# ODOO 19 CE - Configuración de Contenedores
# ===========================================
# Copiar este archivo a .env y ajustar valores
# cp .env.example .env

# ===========================================
# CONFIGURACIÓN WEB (ODOO)
# ===========================================
# Nombre del host para el contenedor Odoo
WEB_HOST=odoo_web_8080

# Puerto externo (acceso desde navegador)
# Cambiar 8083 por otro si hay conflicto
WEB_PORT=8080

# Imagen Docker de Odoo
WEB_IMAGE_NAME=odoo
WEB_IMAGE_TAG=19.0

# Ruta a addons personalizados
WEB_ADDONS_CUSTOMIZE=/opt/odoo8083/addons

# ===========================================
# CONFIGURACIÓN BASE DE DATOS (POSTGRESQL)
# ===========================================
# Nombre de la base de datos
DB_NAME=produccion

# Usuario y contraseña de la BD
DB_USER=odoo
DB_PASSWD=odoo

# Nombre del host para el contenedor DB
# Debe coincidir con el nombre del servicio en docker-compose.yml
DB_HOST=db5432

# Puerto externo de la BD (acceso desde otras apps)
# Cambiar 5435 por otro si hay conflicto
DB_PORT=5432

# Imagen Docker de PostgreSQL
DB_IMAGE=postgres
DB_TAG=15

# ===========================================
# VOLÚMENES (PERSISTENCIA DE DATOS)
# ===========================================
# Directorios donde se guardan los datos
# NO cambiar si ya tenés datos existentes
DB_VOLUMES=/opt/odoo8080/db-data
WEB_VOLUMES=/opt/odoo8080/web-data

# ===========================================
# EJEMPLOS DE PUERTOS PARA MÚLTIPLES ODOO
# ===========================================
# Si querés correr múltiples instancias de Odoo:
#
# Instancia 1 (este archivo):
#   WEB_PORT=8083, DB_PORT=5435
#   Contenedores: odoo_web_8083, db5435
#
# Instancia 2 (copiar y modificar):
#   WEB_PORT=8084, DB_PORT=5436
#   Contenedores: odoo_web_8084, db5436
#   DB_VOLUMES=/opt/odoo8084/db-data
#   WEB_VOLUMES=/opt/odoo8084/web-data
#
# Instancia 3:
#   WEB_PORT=9033, DB_PORT=5433
#   Contenedores: odoo_web_9033, db5433
# ===========================================
