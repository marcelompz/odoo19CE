<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mass_import_suite_launcher" model="ir.ui.view">
        <field name="name">mass.import.suite.launcher.form</field>
        <field name="model">mass.import.suite</field>
        <field name="arch" type="xml">
            <form string="Mass Import Suite">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Seleccione el tipo de importación que desea realizar:
                    </div>
                    <notebook>
                        <page string="Productos" name="products">
                            <group>
                                <div class="text-center mt16">
                                    <p>Importe productos de forma masiva desde Excel, con validación previa y vista previa.</p>
                                    <button name="action_open_product_import"
                                            string="Importar Productos"
                                            type="object"
                                            class="btn-primary btn-lg"
                                            icon="fa-download"/>
                                </div>
                            </group>
                        </page>
                        <page string="Recetas" name="recipes">
                            <group>
                                <div class="text-center mt16">
                                    <p>Importe recetas de Fabricación (MRP) y POS BoM desde Excel.</p>
                                    <button name="action_open_recipe_import"
                                            string="Importar Recetas"
                                            type="object"
                                            class="btn-info btn-lg"
                                            icon="fa-file-excel-o"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mass_import_suite_launcher" model="ir.actions.act_window">
        <field name="name">Mass Import Suite</field>
        <field name="res_model">mass.import.suite</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
