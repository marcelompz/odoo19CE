<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_excel_recipe_import_wizard" model="ir.ui.view">
        <field name="name">excel.recipe.import.wizard.form</field>
        <field name="model">excel.recipe.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Lista de Materiales / Recetas (MRP &amp; POS)">
                <group>
                    <div class="alert alert-info" role="alert">
                        Descargue la plantilla base, complétela con los productos manufacturados, componentes o subproductos, y cárguela aquí para generar automáticamente las Listas de Materiales (LdM / BoM) en Fabricación (MRP) o POS.
                    </div>
                </group>
                <group>
                    <group>
                        <field name="import_type"/>
                    </group>
                    <group>
                        <field name="import_file" filename="import_filename" />
                        <field name="import_filename" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_back_to_launcher" type="object" string="Volver" class="btn-secondary"/>
                    <button name="action_validate" string="Validar Archivo" type="object" class="btn-info" style="background-color: #17a2b8; color: white;"/>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button name="action_download_template" string="Descargar Plantilla Base" type="object" class="btn-secondary"/>
                    <button name="action_export_missing_pos_bom" string="Exportar Faltantes (POS LdM)" type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_excel_recipe_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Lista de Materiales / Recetas</field>
        <field name="res_model">excel.recipe.import.wizard</field>
        <field name="view_mode">form</field>
    </record>

